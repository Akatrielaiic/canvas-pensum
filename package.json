{
	"name": "canvas-pensum",
	"version": "0.12.0",
	"description": "Obsidian plugin: a spatial task manager built on Canvas.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "node --test \"tests/**/*.test.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check:shared": "node scripts/check-shared.mjs"
	},
	"keywords": [
		"obsidian",
		"canvas",
		"tasks"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"typescript": "^5.8.0"
	}
}
